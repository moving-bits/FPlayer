+  private static int getBlockAlign(String mimeType, List<byte[]> initializationData) {
+    if (!mimeType.startsWith("audio/x-ms-wma") || initializationData.size() < 2) {
+      return 0;
+    }
+    byte[] data = initializationData.get(1);
+    if (data.length != 4) {
